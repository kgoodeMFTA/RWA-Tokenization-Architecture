%% Off-chain Data Model (ERD)
%% Only pseudonymous addresses + protocol state live on-chain.

erDiagram
  CONSUMER ||--o{ ACCOUNT : owns
  CONSUMER ||--o{ CONSENT_GRANT : authorizes
  ACCOUNT ||--o{ WEBHOOK_EVENT : emits
  ACCOUNT ||--|| WALLET_MAPPING : maps_to
  WALLET_MAPPING ||--o{ ONCHAIN_TX : produces
  ACCOUNT ||--o{ HITL_REQUEST : triggers
  HITL_REQUEST ||--|| HITL_DECISION : resolves
  CONSUMER ||--o{ CREDIT_DECISION : receives
  CREDIT_DECISION ||--o{ SHAP_EXPLANATION : has

  CONSUMER {
    uuid id PK
    string pseudonymous_id "AES-256-GCM encrypted"
    timestamp created_at
    string sponsor_bank "Bancorp / Stride"
  }
  ACCOUNT {
    uuid id PK
    uuid consumer_id FK
    string galileo_account_id "encrypted"
    string account_type "checking|savings|credit"
    decimal balance
  }
  CONSENT_GRANT {
    uuid id PK
    uuid consumer_id FK
    string fdx_scope
    timestamp granted_at
    timestamp expires_at
    boolean revoked
  }
  WEBHOOK_EVENT {
    uuid id PK
    string event_id UK "from Galileo"
    string event_type
    decimal amount
    string hmac_signature
    timestamp received_at
    boolean processed
  }
  WALLET_MAPPING {
    uuid id PK
    uuid account_id FK
    string onchain_address "0x..."
    string chain "besu|fabric"
  }
  ONCHAIN_TX {
    string tx_hash PK
    string contract_name
    string method
    timestamp block_time
    boolean kyt_cleared
  }
  HITL_REQUEST {
    uuid id PK
    uuid account_id FK
    string action_type "yield_mint|credit_draw|debt_payment"
    decimal amount_usd
    timestamp created_at
    timestamp expires_at
  }
  HITL_DECISION {
    uuid request_id PK FK
    string decision "approve|deny|expire"
    timestamp decided_at
    string decided_by
  }
  CREDIT_DECISION {
    uuid id PK
    uuid consumer_id FK
    decimal pd_score
    decimal lgd_score
    decimal approved_apr
    string model_version
    timestamp decided_at
  }
  SHAP_EXPLANATION {
    uuid decision_id PK FK
    string feature
    decimal shap_value
    string ecoa_reason_code "for adverse action notices"
  }
