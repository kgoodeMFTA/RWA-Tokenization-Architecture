    FAB[("Hyperledger Fabric")]
    DRT["DepositReceiptToken.sol"]
    AMM["RewardAssetAMM.sol"]
    RCL["RWACreditLine.sol"]
    GOV["HITLGovernor.sol"]
    BESU --- DRT
    BESU --- AMM
    BESU --- RCL
    BESU --- GOV
    FAB --- FCC["rwa-cc (Go chaincode)"]
  end

  subgraph Trust ["L6 · Trust Anchor"]
    ORACLE["Chainlink-style Oracle<br/>(T-bill yield, FX, income)"]
    KYT["Chainalysis KYT mock<br/>(AML screening)"]
    HSM["AWS CloudHSM<br/>2-of-3 multisig"]
    USDC["Circle USDC Mint API mock"]
  end

  subgraph External ["External Systems"]
    GALILEO["Galileo Webhook Stream<br/>(mock)"]
    BANK["Sponsor Bank<br/>(Bancorp / Stride)"]
  end

